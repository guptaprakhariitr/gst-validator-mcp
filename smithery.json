  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://gst-validator-mcp.atlasword.workers.dev",
  "repository": "https://github.com/guptaprakhariitr/gst-validator-mcp",
  "categories": ["finance", "india", "compliance", "regulatory"],
  "tags": ["gst", "gstin", "pan", "india", "tax", "verhoeff", "validation"],
  "transport": {
    "type": "http",
    "url": "https://gst-validator-mcp.atlasword.workers.dev/mcp"
  },
  "auth": {
    "type": "bearer",
    "tokenUrl": "https://gst-validator-mcp.atlasword.workers.dev/upgrade",
